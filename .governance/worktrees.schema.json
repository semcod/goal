{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wellmanifest.org/schemas/worktrees/v1",
  "title": "Wellmanifest worktree layout record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "kind",
    "repository",
    "repositoryName",
    "ticket",
    "slug",
    "branch",
    "pathStyle",
    "workspaceRoot",
    "primaryCheckout",
    "worktreesRoot",
    "worktreePath",
    "leasePath"
  ],
  "properties": {
    "schema": {"const": "wellmanifest.worktrees/v1"},
    "kind": {"const": "layout-record"},
    "repository": {"type": "string", "minLength": 1},
    "repositoryName": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "ticket": {"type": "string", "pattern": "^ticket-[0-9]{3,}$"},
    "slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "branch": {"type": "string", "pattern": "^ticket/[0-9]{3,}-[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "pathStyle": {"enum": ["posix", "windows"]},
    "workspaceRoot": {"type": "string", "minLength": 1},
    "primaryCheckout": {"type": "string", "minLength": 1},
    "worktreesRoot": {"type": "string", "minLength": 1},
    "worktreePath": {"type": "string", "minLength": 1},
    "leasePath": {"type": "string", "minLength": 1}
  }
}
